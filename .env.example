APP_ENV=development
LOG_LEVEL=INFO

# 鉴权 JWT：生产必须改成随机长密钥（≥32 字节），例如 python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 开发默认 SQLite；生产可切 Postgres
DATABASE_URL=sqlite:///./labpilot.db

# LLM（OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
AGENT_RECURSION_LIMIT=32
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_TOOL_CALLS=16
# 在操作边界检查时间预算；不强杀已经开始的外部动作。
AGENT_RUN_SECONDS=180
CHAT_MAX_CONCURRENT=8
CHAT_MAX_PER_USER=2
CHAT_STREAM_QUEUE_SIZE=64
CHAT_REQUESTS_PER_MINUTE=20
AUTH_REQUESTS_PER_MINUTE=20

# Zotero MCP（多用户）：用户在设置页绑定自己的 Zotero API Key。
# Docker Compose 扩展自动设置 URL；本机分离运行时填 MCP 的 /mcp 地址。
ZOTERO_MCP_URL=
ZOTERO_MCP_TIMEOUT_SECONDS=10

# 后端与 MCP sidecar 的共享内部令牌；至少 32 字符，不能与 JWT 密钥共用。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
ZOTERO_MCP_INTERNAL_TOKEN=
# 用户 Zotero API Key 的数据库加密密钥；Fernet 密钥须持久保存，丢失无法解密旧绑定。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET=

# RAG
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=10
RAG_RERANK_TOP_N=3
RAG_USE_RERANK=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 入库 embedding 并发上限（防打爆 API 限流）
RAG_EMBED_CONCURRENCY=8

# 邮件：mock=不真发；smtp=审批通过后真发
MAIL_BACKEND=mock
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_SSL=true
EMAIL_FROM_NAME=LabPilot

APPROVAL_TTL_HOURS=72
# 自助提醒：一次授权后自动发送；给他人的邮件仍逐次审批
REMINDER_SCHEDULER_ENABLED=true
REMIND_BEFORE_HOURS=24
REMIND_DEFAULT_TO=
